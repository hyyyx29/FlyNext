# Copy this file to .env and fill in your own values.

DATABASE_URL="file:./dev.db"

JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-another-long-random-string"
JWT_ACCESS_TOKEN_EXPIRY_TIME="1h"
JWT_REFRESH_TOKEN_EXPIRY_TIME="7d"

# External flight-supplier API used for live flight search & booking
AFS_API_KEY="your-api-key"
AFS_BASE_URL="https://advanced-flights-system.replit.app"
